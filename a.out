#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x56490e95ed00 .scope module, "test_add" "test_add" 2 1;
 .timescale 0 0;
v0x56490e939540_0 .var "a", 7 0;
v0x56490e9816a0_0 .var "b", 7 0;
v0x56490e981780_0 .net "res_add", 7 0, L_0x56490e981840;  1 drivers
L_0x56490e981840 .arith/sum 8, v0x56490e939540_0, v0x56490e9816a0_0;
    .scope S_0x56490e95ed00;
T_0 ;
    %pushi/vec4 255, 0, 8;
    %store/vec4 v0x56490e939540_0, 0, 8;
    %pushi/vec4 1, 0, 8;
    %store/vec4 v0x56490e9816a0_0, 0, 8;
    %load/vec4 v0x56490e939540_0;
    %load/vec4 v0x56490e9816a0_0;
    %add;
    %vpi_call 2 7 "$display", "add = %x", S<0,vec4,u8> {1 0 0};
    %load/vec4 v0x56490e939540_0;
    %load/vec4 v0x56490e9816a0_0;
    %add;
    %pushi/vec4 0, 0, 8;
    %cmp/e;
    %flag_get/vec4 4;
    %vpi_call 2 8 "$display", "flag_z = %b", S<0,vec4,u1> {1 0 0};
    %load/vec4 v0x56490e981780_0;
    %pushi/vec4 0, 0, 8;
    %cmp/e;
    %flag_get/vec4 4;
    %vpi_call 2 9 "$display", "flag_z2 = %b", S<0,vec4,u1> {1 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 3;
    "N/A";
    "<interactive>";
    "test_add.v";
